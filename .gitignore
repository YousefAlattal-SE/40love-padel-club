
# ============================================
# 40 LOVE Padel Club & Cafe
# Root .gitignore
# React + Vite | Kotlin + Spring Boot
# PostgreSQL | Flyway | Clerk
# ============================================


# --------------------------------------------
# 1. Environment Variables and Secrets
# --------------------------------------------

.env
.env.*
!.env.example

**/.env
**/.env.*
!**/.env.example

# Spring Boot local configuration
application-local.properties
application-local.yml
application-local.yaml

**/application-local.properties
**/application-local.yml
**/application-local.yaml
**/application-local-*.properties
**/application-local-*.yml
**/application-local-*.yaml

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore


# --------------------------------------------
# 2. Node.js and Frontend Dependencies
# --------------------------------------------

**/node_modules/
**/jspm_packages/
**/bower_components/

# Package manager caches
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Keep package.json and package-lock.json tracked


# --------------------------------------------
# 3. Frontend Build and Cache Files
# --------------------------------------------

**/dist/
**/build/
**/.vite/

.cache/
.parcel-cache/
.next/
.nuxt/
.output/
.svelte-kit/
.turbo/
.astro/

*.tsbuildinfo

vite.config.js.timestamp-*
vite.config.ts.timestamp-*


# --------------------------------------------
# 4. Kotlin / Spring Boot / Gradle
# --------------------------------------------

**/.gradle/
**/out/
**/target/

# Gradle wrapper files must remain tracked:
# backend/gradlew
# backend/gradlew.bat
# backend/gradle/wrapper/


# --------------------------------------------
# 5. IntelliJ IDEA and VS Code
# --------------------------------------------

**/.idea/
*.iml
*.ipr
*.iws

.vscode/
**/.vscode/

.vscode-test/


# --------------------------------------------
# 6. Logs and Runtime Files
# --------------------------------------------

logs/
**/logs/

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

*.pid
*.seed
*.pid.lock

report.[0-9]*.[0-9]*.[0-9]*.json


# --------------------------------------------
# 7. Testing and Coverage
# --------------------------------------------

**/coverage/
**/.nyc_output/
*.lcov

.eslintcache
.stylelintcache

# Playwright generated output
**/test-results/
**/playwright-report/
**/blob-report/


# --------------------------------------------
# 8. PostgreSQL and Database Backups
# --------------------------------------------

*.dump
*.backup
*.sql.gz

# Local exports only
database-backups/
db-backups/
backups/

# IMPORTANT:
# Do NOT ignore *.sql globally.
# Flyway SQL migrations must be tracked:
# backend/src/main/resources/db/migration/


# --------------------------------------------
# 9. Old Git and Local Backups
# --------------------------------------------

.git-serva-backup/

*.bak
*.tmp
*.temp

# --------------------------------------------
# 10. OS Generated Files
# --------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini

# --------------------------------------------
# 11. Miscellaneous Generated Files
# --------------------------------------------

*.tgz
.yarn-integrity
.node_repl_history
.lock-wscript
.grunt/
.docusaurus/
.serverless/
.firebase/
.dynamodb/
.fusebox/
.tern-port

# ============================================
# IMPORTANT:
# Keep these project files tracked:
#
# frontend/src/
# frontend/public/
# frontend/package.json
# frontend/package-lock.json
# backend/src/main/
# backend/src/test/
# backend/src/main/resources/db/migration/
# backend/build.gradle.kts
# backend/gradle/wrapper/
# README.md
# ============================================
