# Backend environment variables (names only - never commit values).
# Set real values in your shell, IDE run configuration or secret manager.

# Database (required). Runtime login is the restricted fortylove_app role.
DB_URL=
DB_USERNAME=fortylove_app
DB_PASSWORD=

# Clerk
CLERK_AUTH_ENABLED=true
CLERK_ISSUER=
CLERK_API_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
CLERK_SECRET_KEY=
CLERK_ALLOW_AUDIENCELESS=false

# Legacy password login (off by default). JWT_SECRET is needed only when enabled,
# except with SPRING_PROFILES_ACTIVE=local, which generates a local key.
LEGACY_JWT_ENABLED=false
JWT_SECRET=
JWT_LIFETIME_MINUTES=30

# Public HTTPS origin (production) and API rate limits
APP_PUBLIC_ORIGIN=
API_GENERAL_PER_MINUTE=240
API_SENSITIVE_PER_MINUTE=20
# Member write actions (bookings, match joins, waitlist) per client per minute
API_WRITE_PER_MINUTE=30
# Reverse proxy IPs/CIDRs allowed to send X-Forwarded-For; empty = trust nobody
TRUSTED_PROXIES=

# Database-backed tests only (gradlew databaseTest) - see README "Database tests"
# FORTYLOVE_TEST_DB_URL=jdbc:postgresql://127.0.0.1:55434/fortylove
# FORTYLOVE_TEST_DB_USERNAME=fortylove_app
# FORTYLOVE_TEST_DB_PASSWORD=
# FORTYLOVE_TEST_CONTAINER_ID=
# FORTYLOVE_TEST_SYSTEM_IDENTIFIER=
